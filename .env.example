# Copy to .env and fill in real values. Never commit .env.
# Local development defaults; the Render deployment is defined in render.yaml.

# --- LLM configuration (provider-agnostic layer) ---
# Provider name must match a registered adapter in llm/providers/.
# "fake" is the built-in offline provider (tests/demos, no API key needed).
# Real providers: gemini, deepseek, openrouter, nvidia.
LLM_PROVIDER=gemini
# Backend-only secret: never send it to the frontend, never commit it.
LLM_API_KEY=
# Optional model override; empty = provider default.
LLM_MODEL=
# Optional API base URL override (empty = provider default endpoint).
LLM_BASE_URL=
# Default timeout for provider calls in seconds.
LLM_TIMEOUT_SECONDS=180

# --- LLM failover chain (extraction + descriptions) ---
# First fallback provider+model, tried when the primary times out or is
# unavailable; empty = no fallback.
LLM_FALLBACK_PROVIDER=nvidia
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FALLBACK_TIMEOUT_SECONDS=120
NVIDIA_NIM_API_KEY=
# Second fallback model (same provider as the fallback above, unless
# LLM_FALLBACK_PROVIDER_2 names another registered provider).
LLM_FALLBACK_MODEL_2=gemini-flash-latest
# IMPORTANT: never set LLM_FALLBACK_PROVIDER_2 to an empty string in a
# deployed env - an empty value becomes the literal provider name. Omit the
# variable entirely (or set it to "gemini") when unused.
# LLM_FALLBACK_PROVIDER_2=

# --- Transient-failure retries (rate limits, flaky transports) ---
# Additional attempts on the SAME provider with exponential backoff before
# the failover chain is consulted.
LLM_RETRY_ATTEMPTS=2
DISCOVERY_RETRY_ATTEMPTS=1
RETRY_BASE_DELAY_SECONDS=1.0

# --- Pipeline run deadline ---
# Hard wall-clock deadline per enrichment run (seconds). After it, paid LLM
# stages are skipped with a NEEDS_REVIEW reason; the run still returns with
# the identity, evidence and delivery preserved.
PIPELINE_RUN_DEADLINE_SECONDS=180

# --- Source discovery ---
# Comma-separated provider names tried in order: "search,gemini" = Serper
# first, Gemini grounding as backup. "" = registered registry only.
DISCOVERY_PROVIDER=search,gemini
# Serper-style search API key (backend env only - never expose through React).
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_BASE_URL=https://google.serper.dev
SEARCH_PROVIDER_TIMEOUT_SECONDS=15
# Max organic results per query (lower = faster free-tier runs).
SEARCH_PROVIDER_RESULTS_LIMIT=6

# --- Gemini (LLM provider AND/OR search discovery) ---
GEMINI_API_KEY=
# Cheap and fast for free-tier throughput.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RESULTS_LIMIT=10

# --- Extraction tuning ---
# Characters of evidence text fed to the LLM per run (lower = faster/cheaper).
EXTRACTION_CONTEXT_BUDGET_CHARS=8000

# --- Source discovery policy ---
# Comma-separated domain patterns (e.g. "dist.acme.com,parts.acme.com").
# SOURCE_ALLOWED_DOMAINS permitlists external-but-trusted domains (official
# distributors etc.); SOURCE_PROHIBITED_DOMAINS rejects specific domains.
SOURCE_ALLOWED_DOMAINS=
SOURCE_PROHIBITED_DOMAINS=

# --- Evidence retrieval limits ---
RETRIEVAL_TIMEOUT_SECONDS=20
RETRIEVAL_MAX_BYTES=5000000
RETRIEVAL_MAX_PDF_BYTES=10000000
RETRIEVAL_USER_AGENT=ProductTruthEngine/0.1 (hackathon)
# Cap on extracted-readable-text per evidence record (characters).
RETRIEVAL_MAX_TEXT_CHARS=20000

# --- Backend / persistence ---
# SQLite is the default; a file is created under data/ at runtime.
# DATA_DIR redirects ALL runtime data (DB default, batch CSVs, deliveries) to
# a persistent volume - required on Render so data survives restarts.
DATABASE_URL=sqlite:///./data/unihack.db
DATA_DIR=
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Batch guardrails ---
# Hard cap on rows enriched per POST /api/batch (and on the MPN list size).
BATCH_MAX_ROWS=50
# Cap on the evidence text stored inside a persisted batch payload (chars per
# evidence record). Evidence ids, URLs and attribute quotes are untouched.
BATCH_PAYLOAD_EVIDENCE_CAP_CHARS=20000

# --- Step 10B: persistent product intelligence cache ---
# A stored record is considered FRESH when last_enriched_at is within this
# many days; older records are STALE and either flagged or re-enriched on
# demand. Set to 0 to disable freshness (everything is treated as stale).
PRODUCT_CACHE_FRESHNESS_DAYS=30

# --- Evaluation endpoint auth ---
# Bearer token required by POST /api/evaluation/run. When unset the endpoint
# is disabled (403). Any random string is fine.
EVALUATION_API_TOKEN=