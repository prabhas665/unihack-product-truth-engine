# Copy to .env and fill in real values. Never commit .env.

# --- LLM configuration (provider-agnostic layer) ---
# Provider name must match a registered adapter in llm/providers/.
# "fake" is the built-in offline provider (tests/demos, no API key needed).
# Real providers (deepseek, openai, gemini, ...) are registered later and
# then require LLM_API_KEY here.
LLM_PROVIDER=
# Backend-only secret: never send it to the frontend, never commit it.
LLM_API_KEY=
# Optional model override; empty = provider default
# (deepseek provider default: "deepseek-chat").
LLM_MODEL=
# Optional API base URL override (empty = provider default endpoint).
# Point this at a local mock/proxy to test the adapter offline.
LLM_BASE_URL=
# Default timeout for provider calls in seconds.
LLM_TIMEOUT_SECONDS=30

# --- Source discovery policy ---
# Comma-separated domain patterns (e.g. "dist.acme.com,parts.acme.com").
# SOURCE_ALLOWED_DOMAINS permitlists external-but-trusted domains (official
# distributors etc.); SOURCE_PROHIBITED_DOMAINS rejects specific domains.
# General marketplaces (Amazon/eBay/...) are rejected by the built-in policy
# and need no entry here.
SOURCE_ALLOWED_DOMAINS=
SOURCE_PROHIBITED_DOMAINS=

# --- Search discovery provider (Step 6B) ---
# Selects the provider used when run_discovery() is called without explicit
# providers: "" = registered registry only (no search provider - the app
# starts without any search configuration); "search" = the search provider.
DISCOVERY_PROVIDER=
# Serper-style search API key (backend env only - never expose through React).
# Required when DISCOVERY_PROVIDER=search.
SEARCH_PROVIDER_API_KEY=
# Optional custom endpoint (allows a local mock during integration testing).
SEARCH_PROVIDER_BASE_URL=https://google.serper.dev
SEARCH_PROVIDER_TIMEOUT_SECONDS=15
SEARCH_PROVIDER_RESULTS_LIMIT=10

# --- Evidence retrieval limits ---
# Connection/read timeout in seconds, and hard size caps (bytes) applied
# while downloading approved candidate sources. HTML cap applies to pages;
# PDF cap applies to PDF documents.
RETRIEVAL_TIMEOUT_SECONDS=20
RETRIEVAL_MAX_BYTES=5000000
RETRIEVAL_MAX_PDF_BYTES=10000000
RETRIEVAL_USER_AGENT=ProductTruthEngine/0.1 (hackathon)

# --- Backend ---
# SQLite is the default; a file is created under data/ at runtime.
DATABASE_URL=sqlite:///./data/unihack.db
APP_HOST=127.0.0.1
APP_PORT=8000
